# Copy to .aero_hand_teleop.env and set the device paths for this workstation.
# Required for real glove input. Keep the vendor binary outside this repository.
MHANDPRO_SDK_LIB=/absolute/path/libVDMocapSDK_mHandPro.so
AERO_HAND_RIGHT_PORT=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_<id>-if00
AERO_HAND_LEFT_PORT=
ROS_DOMAIN_ID=42
