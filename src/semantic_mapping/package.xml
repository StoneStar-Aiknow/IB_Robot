<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_mapping</name>
  <version>0.1.0</version>
  <description>Persistent RGB-D 3D semantic mapping with open-vocabulary perception</description>
  <maintainer email="dev@openeuler.org">IB-Robot Developers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <depend>rosidl_runtime_py</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <exec_depend>embodied_common</exec_depend>
  <exec_depend>perception_service</exec_depend>
  <exec_depend>robot_config</exec_depend>
  <exec_depend>robot_calibration</exec_depend>
  <exec_depend>robot_navigation</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
