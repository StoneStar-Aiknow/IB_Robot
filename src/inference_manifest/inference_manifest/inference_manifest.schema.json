{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibrobot.example/schemas/inference_manifest.schema.json",
  "title": "IB-Robot Unified Inference Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle",
    "deployments"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "bundle": {
      "$ref": "#/$defs/bundle"
    },
    "deployments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/torch_deployment"
          },
          {
            "$ref": "#/$defs/compiled_deployment"
          }
        ]
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "bundle_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "scope",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "const": "structure"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "revision",
        "name",
        "files",
        "digest"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundle_file"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc",
        "runtime"
      ],
      "properties": {
        "soc": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "format": {
          "$ref": "#/$defs/non_empty_string"
        },
        "share_group": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "shape_dimension": {
      "oneOf": [
        {
          "const": -1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic",
        "dtype",
        "shape"
      ],
      "properties": {
        "semantic": {
          "$ref": "#/$defs/non_empty_string"
        },
        "runtime_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "dtype": {
          "enum": [
            "bool",
            "uint8",
            "int8",
            "int16",
            "int32",
            "int64",
            "float16",
            "bfloat16",
            "float32",
            "float64"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape_dimension"
          }
        },
        "layout": {
          "enum": [
            "NCHW",
            "NHWC"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "runtime_name"
          ]
        },
        {
          "required": [
            "index"
          ]
        }
      ],
      "if": {
        "properties": {
          "semantic": {
            "pattern": "^observation\\.images?(?:\\.|$)"
          }
        },
        "required": [
          "semantic"
        ]
      },
      "then": {
        "required": [
          "layout"
        ]
      },
      "else": {
        "not": {
          "required": [
            "layout"
          ]
        }
      }
    },
    "artifact_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "device_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic",
        "producer",
        "consumer",
        "transport",
        "owner"
      ],
      "properties": {
        "semantic": {
          "type": "string",
          "pattern": "^internal\\.[A-Za-z0-9_.-]+$"
        },
        "producer": {
          "$ref": "#/$defs/role"
        },
        "consumer": {
          "$ref": "#/$defs/role"
        },
        "producer_binding": {
          "enum": [
            "output",
            "input"
          ],
          "default": "output"
        },
        "transport": {
          "const": "device_pointer"
        },
        "owner": {
          "enum": [
            "producer",
            "consumer"
          ]
        },
        "lifetime": {
          "const": "inference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "producer_binding": {
                "const": "input"
              }
            },
            "required": [
              "producer_binding"
            ]
          },
          "then": {
            "properties": {
              "owner": {
                "const": "producer"
              }
            }
          }
        }
      ]
    },
    "torch_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "revision",
        "backend",
        "device"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "backend": {
          "const": "torch"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda",
            "mps",
            "npu"
          ]
        }
      }
    },
    "compiled_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "revision",
        "backend",
        "target",
        "artifacts",
        "execution",
        "bindings"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "backend": {
          "enum": [
            "ascend",
            "hisilicon",
            "rknn",
            "hmm"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/role"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "execution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/role"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact_bindings"
          }
        },
        "device_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device_link"
          }
        }
      }
    }
  }
}
