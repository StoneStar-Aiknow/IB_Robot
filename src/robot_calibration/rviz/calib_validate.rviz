Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: MID-360 Preview Cloud
      Topic:
        Reliability Policy: Best Effort
        Value: /calib/preview/cloud
      Size (Pixels): 2
      Style: Points
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: RealSense Preview
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /calib/preview/image
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Calib Overlay
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /calib/overlay
      Enabled: true
      Value: true
  Global Options:
    Fixed Frame: body
  Tools:
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
Window Geometry:
  Width: 1440
  Height: 900
