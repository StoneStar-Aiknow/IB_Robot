<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>embodied_bringup</name>
  <version>0.0.1</version>
  <description>Launch orchestration for the embodied AI runtime pipeline</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>embodied_common</depend>
  <depend>robot_config</depend>
  <exec_depend>embodied_agent</exec_depend>
  <exec_depend>ibrobot_agent</exec_depend>
  <exec_depend>skill_catalog</exec_depend>
  <exec_depend>skill_library</exec_depend>
  <exec_depend>safety_guard</exec_depend>
  <exec_depend>perception_service</exec_depend>
  <!-- The recording launch wiring moved to dataset_tools (openspec change
       ``migrate-business-launch-builders``): the embodied pipeline's
       record:=true consumers participate through the
       ibrobot.launch_builders entry point group, so the package must be
       present for them to register. -->
  <exec_depend>dataset_tools</exec_depend>
  <exec_depend>manipulation_service</exec_depend>
  <exec_depend>manipulation_execution</exec_depend>
  <exec_depend>robot_runtime</exec_depend>
  <exec_depend>robot_skill_cli</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ibrobot_agent</test_depend>
  <test_depend>skill_library</test_depend>
  <test_depend>embodied_common</test_depend>
  <test_depend>ibrobot_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <!-- The migrated launch-builder tests import the perception-model node
       generator and the recording builder from their owning packages
       (openspec change ``migrate-business-launch-builders``, design
       decision 3). -->
  <test_depend>inference_service</test_depend>
  <test_depend>dataset_tools</test_depend>
  <!-- Real-config grasp startup regression (openspec change
       ``cleanup-manipulation-so101-providers`` D5): this is the only package
       that may depend on robot_config, manipulation_execution and the robot
       suites without a cycle. Test-only — the runtime import guard still
       keeps the generic nodes robot-free. -->
  <test_depend>manipulation_execution</test_depend>
  <test_depend>inference_manifest</test_depend>
  <!-- The D5 suite additionally imports robot_config (loader, binding,
       runtime target), robot_runtime (description, profile) and rclpy
       directly. -->
  <test_depend>robot_config</test_depend>
  <test_depend>robot_runtime</test_depend>
  <test_depend>rclpy</test_depend>
  <!-- so101_suite provides the grasp geometry / wrist guard modules the
       loaded YAMLs declare, and test_so101_provider_contract checks them
       against the consumer's contract here so that neither package depends on
       the other; so101_description the gripper meshes; -->
  <test_depend>so101_suite</test_depend>
  <test_depend>so101_description</test_depend>
  <!-- so101_motion ships ik_workers.launch.py that the handeye configs'
       grasp_execution.ik.workers_launch names; -->
  <test_depend>so101_motion</test_depend>
  <!-- lekiwi_robot ships the runtime profile the runtime-backed LeKiwi
       grasp configs resolve. -->
  <test_depend>lekiwi_robot</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
