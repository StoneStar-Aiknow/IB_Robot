<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manipulation_execution</name>
  <version>0.1.0</version>
  <description>Closed-loop manipulation execution for agent-facing IB-Robot skills</description>
  <maintainer email="roboguru.92@gmail.com">IB-Robot Contributors</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>robot_runtime</depend>
  <depend>tf2_ros</depend>
  <depend>ibrobot_msgs</depend>
  <depend>embodied_common</depend>
  <depend>skill_catalog</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- Transport decode of the platform's encoded camera stream, in
       compressed_image_decode.py. Model-semantic preprocessing (letterbox,
       channel order, crop, resize, normalise) stays in the perception
       adapters; this is only JPEG/PNG -> raw Image. -->
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
