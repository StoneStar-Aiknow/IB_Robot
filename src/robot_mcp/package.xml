<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_mcp</name>
  <version>0.1.0</version>
  <description>MCP tool layer exposing IB-Robot runtime skills/status to MCP-compatible agent hosts (opencode/Claude Code/Cursor).</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>robot_config</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
