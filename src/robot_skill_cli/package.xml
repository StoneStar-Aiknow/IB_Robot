<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_skill_cli</name>
  <version>0.1.0</version>
  <description>Controlled CLI surface for LLM/Agent ROS access in IB-Robot.</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>ibrobot_msgs</depend>
  <depend>robot_config</depend>
  <depend>embodied_common</depend>
  <depend>ament_index_python</depend>
  <depend>skill_catalog</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
