<?xml version="1.0" encoding="UTF-8"?>
<policy version="0.2.0">
  <enclaves>
    <enclave path="/hermes_cli">
      <profiles>
        <profile ns="/" node="default">
          <services request="ALLOW">
            <service>/embodied/plan_agent_command</service>
            <service>/embodied/validate_agent_plan</service>
            <service>/embodied/confirm_agent_plan</service>
            <service>/embodied/get_skill_gateway_status</service>
            <service>/embodied/get_skill_snapshot</service>
            <service>/embodied/validate_skill</service>
          </services>
          <actions call="ALLOW">
            <action>/embodied/execute_agent_plan</action>
          </actions>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/operator">
      <profiles>
        <profile ns="/" node="default">
          <services request="ALLOW">
            <service>/embodied/reload_skill_catalog</service>
          </services>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/agent_plan_node">
      <profiles>
        <profile ns="/" node="agent_plan_node">
          <services reply="ALLOW" request="ALLOW">
            <service>/embodied/plan_agent_command</service>
            <service>/embodied/validate_agent_plan</service>
            <service>/embodied/confirm_agent_plan</service>
            <service>/embodied/get_skill_gateway_status</service>
            <service>/embodied/get_skill_snapshot</service>
            <service>/embodied/validate_skill</service>
            <service>/embodied/begin_workflow_execution</service>
            <service>/embodied/finalize_workflow_execution</service>
          </services>
          <actions call="ALLOW" execute="ALLOW">
            <action>/embodied/execute_skill</action>
            <action>/embodied/execute_agent_plan</action>
          </actions>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/skill_executor_node">
      <profiles>
        <profile ns="/" node="skill_executor_node">
          <topics publish="ALLOW" subscribe="ALLOW">
            <topic>/embodied/skill_registry_events</topic>
            <topic>/joint_states</topic>
            <topic>/robot_status/ee_pose</topic>
          </topics>
          <services reply="ALLOW" request="ALLOW">
            <service>/embodied/get_skill_gateway_status</service>
            <service>/embodied/get_skill_snapshot</service>
            <service>/embodied/reload_skill_catalog</service>
            <service>/embodied/begin_workflow_execution</service>
            <service>/embodied/finalize_workflow_execution</service>
            <service>/embodied/validate_skill</service>
            <service>/embodied/validate_primitive</service>
            <service>/moveit_gateway/move_to_configuration</service>
          </services>
          <actions call="ALLOW" execute="ALLOW">
            <action>/embodied/execute_skill</action>
            <action>/embodied/execute_primitive</action>
            <action>/task_executor/execute_task_plan</action>
            <action>/arm_trajectory_controller/follow_joint_trajectory</action>
            <action>/manipulation/execute_pick</action>
          </actions>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/safety_guard_node">
      <profiles>
        <profile ns="/" node="safety_guard_node">
          <topics subscribe="ALLOW">
            <topic>/embodied/skill_registry_events</topic>
          </topics>
          <services reply="ALLOW" request="ALLOW">
            <service>/embodied/validate_skill</service>
            <service>/embodied/validate_primitive</service>
            <service>/embodied/get_skill_gateway_status</service>
            <service>/embodied/get_skill_snapshot</service>
          </services>
        </profile>
      </profiles>
    </enclave>
  </enclaves>
</policy>
