<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_service</name>
  <version>0.1.0</version>
  <description>Continuous multimodal scene understanding service for embodied interaction</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ibrobot_msgs</depend>
  <depend>embodied_common</depend>
  <exec_depend>inference_manifest</exec_depend>
  <exec_depend>inference_service</exec_depend>
  <!-- Bundle packaging only: package_graspgen_ascend_bundle reads compiled OM ABIs
       through model_utils.inference_manifest_export. The runtime services do not. -->
  <exec_depend>model_utils</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
