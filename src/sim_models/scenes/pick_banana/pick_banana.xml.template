<mujoco model="pick_banana">
  <!--
    pick_banana MuJoCo scene template.
    Placeholders substituted at launch time by scene_compiler.get_mujoco_scene_path():
      {{ROBOT_XML_PATH}}  — absolute path to robot MJCF (e.g. so101.xml); T6 fills this.
                            When omitted from get_mujoco_scene_path(), this include line
                            is stripped so the file works standalone in MuJoCo Viewer.
      {{MESHES_DIR}}      — absolute path to this scene's meshes/ directory.

    Object parameters (positions, scales, physics) match so101_full_scene.xml exactly.
  -->
  <include file="{{ROBOT_XML_PATH}}"/>

  <visual>
    <headlight diffuse="0.15 0.15 0.15" ambient="0.6 0.6 0.6" specular="0.0 0.0 0.0"/>
    <quality shadowsize="2048"/>
    <rgba haze="0.15 0.25 0.35 1.0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.0 0.0 0.0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="mat_bluetable" specular="0.05" shininess="0.01"/>
    <material name="mat_plate" specular="0.1" shininess="0.02"/>
    <mesh name="bluetable_mesh"    file="{{MESHES_DIR}}/bluetable.obj"      scale="0.156 0.156 0.156"/>
    <mesh name="green_curten_mesh" file="{{MESHES_DIR}}/greencurten_mj.obj" scale="0.15 0.15 0.15"/>
    <mesh name="plate_mesh"        file="{{MESHES_DIR}}/plate.obj"              scale="0.09539 0.09539 0.09539"/>
    <mesh name="plate_col_mesh"    file="{{MESHES_DIR}}/plate_collision.stl"  scale="1 1 1"/>
    <mesh name="banana_mesh"       file="{{MESHES_DIR}}/banana_g.obj"         scale="1 1 1"/>
    <!-- CoACD convex decomposition: 4 convex hulls approximating the C-shaped banana.
         Generated by scripts/decompose_banana.py (threshold=0.04, max_convex_hull=6). -->
    <mesh name="banana_col_0" file="{{MESHES_DIR}}/banana_col_0.stl" scale="1 1 1"/>
    <mesh name="banana_col_1" file="{{MESHES_DIR}}/banana_col_1.stl" scale="1 1 1"/>
    <mesh name="banana_col_2" file="{{MESHES_DIR}}/banana_col_2.stl" scale="1 1 1"/>
    <mesh name="banana_col_3" file="{{MESHES_DIR}}/banana_col_3.stl" scale="1 1 1"/>
  </asset>

  <worldbody>
    <light pos="1.0 1.0 3.5" dir="-0.2 -0.2 -1.0" directional="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.411" type="plane" material="groundplane"/>
    <!--
      table_surface: rigid contact, matches banana/gripper solref="0.004 1".
      solref_eff = √(0.004×0.004) = 0.004 → k = m/t² ≈ 1875 N/m per contact point.
    -->
    <geom name="table_surface" type="plane" pos="0 0 0.0" size="0 0 0.05"
          rgba="0 0 0 0" contype="1" conaffinity="1" group="0"
          solimp="0.99 0.999 0.001 0.5 2" solref="0.004 1"/>

    <body name="bluetable" pos="0.000000 0.000000 -0.321000" euler="1.570796 0.000000 0.000000">
      <geom type="mesh" mesh="bluetable_mesh" rgba="0.2000 0.3000 0.6500 1.0000"
            contype="0" conaffinity="0" group="1" material="mat_bluetable"/>
    </body>

    <body name="green_curten" pos="0.000000 -0.345000 0.000000" euler="1.570796 0.000000 3.141593">
      <geom type="mesh" mesh="green_curten_mesh" rgba="0.1000 0.7000 0.1800 1.0000"
            contype="0" conaffinity="0" group="1"/>
    </body>

    <body name="plate" pos="0.220000 0.020000 0.020000" euler="1.570796 0.000000 0.000000"
          gravcomp="0">
      <!--
        plate_collision.stl: generated at scale=0.09539 (19cm diameter).
        Body euler=Rx(90°) same as Gazebo — STL local y → world -z after rotation.
        scale="1 1 1": STL already contains the 0.09539 scaling.
        Visual plate_mesh also updated to scale=0.09539 to match.
      -->
      <joint name="plate_free" type="free" damping="0.01"/>
      <geom type="mesh" mesh="plate_mesh" rgba="0.9200 0.9000 0.8500 1.0000"
            contype="0" conaffinity="0" group="1" material="mat_plate"
            friction="1.0 0.01 0.001" condim="4" mass="0"
            solimp="0.99 0.999 0.0005 0.5 2" solref="0.004 2"/>
      <geom type="mesh" mesh="plate_col_mesh" rgba="0 0 0 0"
            contype="1" conaffinity="1" group="0"
            friction="1.0 0.01 0.001" condim="4" mass="0.2"
            solimp="0.99 0.999 0.0005 0.5 2" solref="0.004 2"/>
    </body>

    <body name="banana" pos="0.000000 0.020000 0.050000" euler="0 0 0"
          gravcomp="0">
      <!--
        banana_g.obj: z-up mesh, no rotation needed (euler="0 0 0").
        BBox: x:-0.1021..+0.0729, y:-0.0615..+0.0347, z:0.0002..0.0350 (17.5cm long).
        spawn z=0.05: drops under gravity onto table_surface at z=0 (MuJoCo has no
        0.002 offset unlike Gazebo — see coordinate notes in plans/banana-mujoco/plan.md).
        mass=0.03 kg (30g measured plastic banana).
        damping=5.0: decays contact-excited oscillations without sluggish feel.
      -->
      <joint name="banana_free" type="free" damping="0.005"/>
      <geom type="mesh" mesh="banana_mesh" rgba="0.9600  0.8500 0.1000 1.0000"
            contype="0" conaffinity="0" group="1" mass="0"/>
      <!-- CoACD convex decomposition: 4 convex hulls covering the C-shaped banana.
           Mass distributed by volume fraction (total 0.03 kg).
           solimp/solref: rigid-body mode matching gripper params — no deformation. -->
      <geom type="mesh" mesh="banana_col_0" rgba="0 0 0 0"
            contype="1" conaffinity="1" group="0"
            friction="15.0 0.5 0.05" condim="4" mass="0.01200"
            solimp="0.99 0.999 0.005 0.5 2" solref="0.004 1"/>
      <geom type="mesh" mesh="banana_col_1" rgba="0 0 0 0"
            contype="1" conaffinity="1" group="0"
            friction="15.0 0.5 0.05" condim="4" mass="0.00600"
            solimp="0.99 0.999 0.005 0.5 2" solref="0.004 1"/>
      <geom type="mesh" mesh="banana_col_2" rgba="0 0 0 0"
            contype="1" conaffinity="1" group="0"
            friction="15.0 0.5 0.05" condim="4" mass="0.01000"
            solimp="0.99 0.999 0.005 0.5 2" solref="0.004 1"/>
      <geom type="mesh" mesh="banana_col_3" rgba="0 0 0 0"
            contype="1" conaffinity="1" group="0"
            friction="15.0 0.5 0.05" condim="4" mass="0.01200"
            solimp="0.99 0.999 0.005 0.5 2" solref="0.004 1"/>
    </body>
  </worldbody>
</mujoco>
