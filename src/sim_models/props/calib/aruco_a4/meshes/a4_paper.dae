<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="millimeter" meter="0.001"/>
    <up_axis>Y_UP</up_axis>
  </asset>

  <library_images>
    <image id="Image_tex" name="Image_tex">
      <init_from>a4_tex.png</init_from>
    </image>
  </library_images>

  <library_effects>
    <effect id="Effect_tex">
      <profile_COMMON>
        <newparam sid="Surface_tex">
          <surface type="2D"><init_from>Image_tex</init_from></surface>
        </newparam>
        <newparam sid="Sampler_tex">
          <sampler2D><source>Surface_tex</source></sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <diffuse>
              <texture texture="Sampler_tex" texcoord="UVMap"/>
            </diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Effect_white">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <diffuse><color>1 1 1 1</color></diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="Material_tex" name="Material_tex">
      <instance_effect url="#Effect_tex"/>
    </material>
    <material id="Material_white" name="Material_white">
      <instance_effect url="#Effect_white"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="Mesh_A4" name="A4Paper">
      <mesh>
        <source id="positions">
          <float_array id="positions-array" count="24">0.0000 0.0000 0.0000 210.0000 0.0000 0.0000 210.0000 0.0000 297.0000 0.0000 0.0000 297.0000 0.0000 1.0000 0.0000 210.0000 1.0000 0.0000 210.0000 1.0000 297.0000 0.0000 1.0000 297.0000</float_array>
          <technique_common>
            <accessor source="#positions-array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="uvs">
          <float_array id="uvs-array" count="8">1.000000 0.000000 0.000000 0.000000 0.000000 1.000000 1.000000 1.000000</float_array>
          <technique_common>
            <accessor source="#uvs-array" count="4" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="vertices">
          <input semantic="POSITION" source="#positions"/>
        </vertices>
        <triangles count="2" material="Material_tex">
          <input semantic="VERTEX"   source="#vertices" offset="0"/>
          <input semantic="TEXCOORD" source="#uvs"      offset="1" set="0"/>
          <p>4 0 7 3 6 2 4 0 6 2 5 1</p>
        </triangles>
        <triangles count="10" material="Material_white">
          <input semantic="VERTEX"   source="#vertices" offset="0"/>
          <input semantic="TEXCOORD" source="#uvs"      offset="1" set="0"/>
          <p>0 0 2 0 1 0 0 0 3 0 2 0 0 0 5 0 4 0 0 0 1 0 5 0 3 0 6 0 2 0 3 0 7 0 6 0 0 0 4 0 7 0 0 0 7 0 3 0 1 0 6 0 5 0 1 0 2 0 6 0</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="A4Paper" name="A4Paper" type="NODE">
        <instance_geometry url="#Mesh_A4">
          <bind_material>
            <technique_common>
              <instance_material symbol="Material_tex" target="#Material_tex">
                <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
              <instance_material symbol="Material_white" target="#Material_white">
                <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
