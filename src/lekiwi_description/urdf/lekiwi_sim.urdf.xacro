<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">

  <!--
    Simulation URDF: thin wrapper around lekiwi_robot macro.
    Uses cylinder wheel collisions, CPU lidar, no camera,
    odometry publisher, and anisotropic friction for omni wheel sim.
  -->

  <!-- Include robot macro (single source of truth) -->
  <xacro:include filename="$(find lekiwi_description)/urdf/lekiwi_macro.xacro"/>

  <!-- Arguments -->
  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="sim_plugin" default="gz_ros2_control/GazeboSimSystem"/>
  <xacro:arg name="gz_ros2_control_parameters_file" default="$(find robot_config)/config/lekiwi/lekiwi_sim_controllers.yaml"/>
  <xacro:arg name="serial_port"  default="${serial_port}"/>
  <xacro:arg name="use_mock"     default="${use_mock}"/>
  <xacro:arg name="i2c_bus"     default="${imu_i2c_bus}"/>
  <xacro:arg name="i2c_addr"    default="${imu_i2c_addr}"/>
  <xacro:arg name="axis_remap"  default="${imu_axis_remap}"/>
  <xacro:arg name="sensor_mode" default="${imu_sensor_mode}"/>

  <!-- Simulation variant: cylinder collisions, CPU lidar, no camera, odom publisher, anisotropic friction -->
  <xacro:lekiwi_robot
    use_sim="$(arg use_sim)"
    sim_plugin="$(arg sim_plugin)"
    gz_ros2_control_parameters_file="$(arg gz_ros2_control_parameters_file)"
    serial_port="$(arg serial_port)"
    use_mock="$(arg use_mock)"
    i2c_bus="$(arg i2c_bus)"
    i2c_addr="$(arg i2c_addr)"
    axis_remap="$(arg axis_remap)"
    sensor_mode="$(arg sensor_mode)"
    sim_wheel_collision="true"
    sim_cpu_lidar="true"
    sim_camera="false"
    sim_odom_publisher="true"
    sim_aniso_friction="true"/>

</robot>
