# PlanAgentCommand.srv - Capture the exact current snapshot for a caller-built
# typed Workflow.
#
# See docs/lightweight_skill_package_registry_design_zh.md section 11.6.
#
# workflow_steps may only select enabled && planner_visible Atomic Operator /
# Skill entries. raw_command is audit text only and is never parsed by the
# robot runtime. A retry with the same request_id, audit text, typed steps and
# exact identity returns the same plan/token; a conflicting payload returns
# SKILL_REQUEST_ID_CONFLICT. schema_version is 1 in v1.

uint32 schema_version
string request_id
string raw_command
WorkflowStep[] workflow_steps
---
bool success
AgentPlan plan
string error_code
string message
SkillDiagnostic[] diagnostics
