# Execute one atomic navigation command.

uint8 ABSOLUTE_POSE=0
uint8 FORWARD=1
uint8 BACKWARD=2
uint8 STRAFE_LEFT=3
uint8 STRAFE_RIGHT=4
uint8 TURN_LEFT=5
uint8 TURN_RIGHT=6

# ABSOLUTE_POSE ignores value and uses target_pose in the map frame.
# relative commands ignore target_pose; translation commands use meters.
# TURN_LEFT and TURN_RIGHT use radians for value.
uint8 command_type
geometry_msgs/PoseStamped target_pose
float64 value
---
uint16 NONE=0
uint16 INVALID_GOAL=1
uint16 BUSY=2
uint16 TF_UNAVAILABLE=3
uint16 NAV2_UNAVAILABLE=4
uint16 GOAL_REJECTED=5
uint16 NAVIGATION_ABORTED=6
uint16 NAVIGATION_CANCELED=7
uint16 STOP_TIMEOUT=8
uint16 INTERNAL_ERROR=255

bool success
uint16 error_code
string message
geometry_msgs/PoseStamped resolved_target_pose
---
string state
float32 distance_remaining
builtin_interfaces/Duration estimated_time_remaining
int16 number_of_recoveries
