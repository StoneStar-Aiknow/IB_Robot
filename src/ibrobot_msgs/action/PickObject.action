# PickObject.action - Grasp closed-loop action served by
# manipulation_execution/pick_executor_node at /manipulation/execute_pick.
#
# See docs/lightweight_skill_package_registry_design_zh.md section 11.5.
#
# This is a delegated action: it must carry DispatchBinding and
# DelegatedExecutorIdentity expected_executor in the goal and return
# actual_executor in the result. The delegated server must compare its own
# actual identity before accepting the request; on mismatch it returns a
# stable contract-version error and must not rely on the endpoint name alone.
# task_id is moved into dispatch_binding. Future delegated actions/services
# follow the same shape.

# --- Goal ---
DispatchBinding dispatch_binding
string target_query
float32 timeout_sec
DelegatedExecutorIdentity expected_executor
---
# --- Result ---
uint8 VERIFICATION_NOT_RUN=0
uint8 VERIFICATION_SUCCESS=1
uint8 VERIFICATION_FAILED=2
uint8 VERIFICATION_UNCERTAIN=3

bool success
string error_code
string message
uint32 attempts
uint8 verification_status
float32 verification_confidence
string debug_output_dir
string[] completed_phases
DelegatedExecutorIdentity actual_executor
---
# --- Feedback ---
string phase
float32 progress
uint32 attempt
string detail
