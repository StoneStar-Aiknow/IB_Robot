# PrimitiveCommand.action - Atomic motion action served by skill_executor_node
# at /embodied/execute_primitive.
#
# See docs/lightweight_skill_package_registry_design_zh.md section 11.5.
#
# Internal and delegated cross-process dispatch must carry the exact active
# DispatchBinding. For an explicitly admitted external-root Primitive, the
# Gateway canonicalizes the binding only after acquiring the exclusive root
# lease. Primitive server matches every field of an active child binding, not
# just task id; child finalize/cancel invalidates dispatch_nonce immediately.
# schema_version on DispatchBinding is 1 in v1.

# --- Goal ---
uint32 schema_version
DispatchBinding dispatch_binding
# Correlation token derived from the parent PickObject goal UUID. Authorization
# is always decided from dispatch_binding; callers must not use this as a lease.
string execution_token
string primitive_name
uint8 navigation_command_type
geometry_msgs/PoseStamped navigation_target_pose
float64 navigation_value
string pose_name
geometry_msgs/Pose target_pose
float32 relative_dx
float32 relative_dy
float32 relative_dz
float32 velocity_scaling
float32 gripper_position
string[] joint_names
float32[] joint_positions
float32 primitive_duration_sec
float32[] joint_waypoints
uint32 joint_waypoint_count
float32 waypoint_duration_sec
float32 timeout_sec
---
# --- Result ---
bool success
string error_code
string message
string pose_name
string actual_registry_epoch
uint64 actual_registry_generation
string actual_registry_digest
---
# --- Feedback ---
string state
string detail
