# SkillCommand.action - Skill / Atomic Operator execution action. Served by
# skill_executor_node at /embodied/execute_skill.
#
# See docs/lightweight_skill_package_registry_design_zh.md section 11.5.
#
# The SkillCommand name in v1 carries both Atomic Operator and Skill to limit
# the IDL migration surface; admission reads semantic_level from the snapshot
# and validates the v1 structural invariants. Callers must not self-report the
# level. Public parameter fields must stay in sync with WorkflowStep and
# ValidateSkill. has_x/has_y/has_yaw distinguish omitted coordinates from an
# explicit zero value.
# dispatch_binding carries the full task/version envelope (task_id moved here).
# timeout_sec is the per-catalog-entry request cap.
#
# The dispatch_binding must provide complete expected identity on planned
# SkillCommand; root_lease_nonce is only for Workflow child SkillCommand (and
# its read-only validation / internal dispatch) and must be empty for direct
# root SkillCommand (with workflow_step_index=0). dispatch_nonce is always
# empty on the SkillCommand goal.

# --- Goal ---
uint32 schema_version
DispatchBinding dispatch_binding
string skill_name
string target_name
string container_name
string place_name
string motion_direction
float32 motion_distance
string direction
float64 distance
float64 degree
bool has_x
float64 x
bool has_y
float64 y
bool has_yaw
float64 yaw
float32 timeout_sec
---
# --- Result ---
bool success
string error_code
string message
string[] executed_primitives
string actual_registry_epoch
uint64 actual_registry_generation
string actual_registry_digest
string source_release_digest
string provenance_digest
string debug_output_dir
SkillDiagnostic[] diagnostics
---
# --- Feedback ---
string state
string detail
string actual_registry_epoch
uint64 actual_registry_generation
