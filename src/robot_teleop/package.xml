<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_teleop</name>
  <version>0.1.0</version>
  <description>Minimal serial-to-controller bridge for zero-latency teleoperation</description>

  <maintainer email="maintainer@example.com">IB-Robot Team</maintainer>
  <license>Apache-2.0</license>

  <author email="author@example.com">IB-Robot Team</author>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>robot_runtime</depend>
  <!-- Launch-builder registration (openspec change
       ``migrate-business-launch-builders``): launch_builders/teleop.py
       contributes the teleop entry to robot_config's launch registry
       through the ibrobot.launch_builders entry point group, and the
       operator launch entry loads robot configs — both import robot_config
       at runtime. The dependency is one way: robot_config does not depend
       on robot_teleop. -->
  <depend>robot_config</depend>
  <depend>ibrobot_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>tf2_ros</depend>
  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>joy</exec_depend>
  <!-- joy_teleop moved here with the teleop launch builder (it launches
       joy_teleop nodes for mobile-base profiles); robot_config no longer
       declares it. -->
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>

  <!-- Test dependencies -->
  <test_depend>python3-pytest</test_depend>
  <!-- The migrated launch-builder and operator-launch tests import
       robot_config's loader and registry (openspec change
       ``migrate-business-launch-builders``). -->
  <test_depend>robot_config</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
