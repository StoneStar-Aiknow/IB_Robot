<?xml version="1.0"?>

<!--
  This file is based on the SO-ARM100 model from:
  https://github.com/TheRobotStudio/SO-ARM100
  and has been modified accordingly.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!--
	  TCP (Tool Center Point) offset along the gripper finger extension.
	  The SO-101 fingers extend along the gripper link's -Z axis (the jaw tip
	  delta from the gripper origin is dominantly -Z), so a point on this line
	  sits out at the jaws. Default 0.09 m places the TCP between the two jaw
	  faces (single source of truth for the TCP geometry).
	  A small -X offset re-centers the TCP onto the jaw mid-line.
	-->
	<xacro:arg name="tcp_offset_x" default="-0.005" />
	<xacro:arg name="tcp_offset_z" default="-0.095" />
	<!-- root_link (lekiwi-nav-grasp-sim-platforms D8): the arm model's root
	     link and base_joint's parent. The default `world` keeps every
	     SO-101 render byte-identical (pinned by test/golden). A robot that
	     mounts this arm MID-CHAIN overrides the arg before the include: the
	     URDF->SDF lumping turns a mid-chain link named `world` into a
	     model-level frame, which gz-sim Fortress rejects as reserved. The
	     first <xacro:arg> declaration wins. (xacro drops comments preceding
	     an <xacro:arg>, so this note stays out of the rendered output.) -->
	<xacro:arg name="root_link" default="world" />
	<!-- jaw_collision (lekiwi-nav-grasp D7, maintainer decision 2026-10-29):
	     `mesh` (default) keeps the raw wrist_roll_follower/moving_jaw STL
	     collision of every hardware, SDK and MoveIt render byte-identical
	     (pinned by test/golden); `hulls` swaps BOTH jaw links' collision to
	     the same CoACD convex decomposition the MuJoCo MJCF simulates
	     (wrist_roll_follower_col_0..7 / moving_jaw_col_0..7, poses exactly as
	     in so101.xml.template), so a Gazebo simulation collides with the
	     same jaw shapes MuJoCo does. The Gazebo render paths set `hulls`
	     (robot_runtime.launch_support.render_gazebo_description). The
	     visuals never change. First <xacro:arg> declaration wins. -->
	<xacro:arg name="jaw_collision" default="mesh" />
	<!-- jaw_collision validation: an unknown value FAILS the render (an
	     undefined macro below) instead of silently falling back to the raw
	     STL — a typo must never disable the hulls (task 2.0b). Mechanism
	     note: this xacro has NO raising error function usable in
	     expressions (xacro.error only logs; property values are lazy), so
	     an undefined macro — whose name carries the message — is the
	     explicit failure available here. -->
	<xacro:if value="${'$(arg jaw_collision)' != 'mesh' and '$(arg jaw_collision)' != 'hulls'}">
		<xacro:invalid_jaw_collision_value value="$(arg jaw_collision)" />
	</xacro:if>
	<xacro:property name="jaw_collision_hulls" value="${'$(arg jaw_collision)' == 'hulls'}" />
	<!-- gripper_effort (lekiwi-nav-grasp D7 "Gazebo gripper effort",
	     maintainer decision 2026-10-30): the joint-6 effort limit. The
	     default 10 keeps every hardware/SDK/MoveIt render byte-identical
	     (pinned by test/golden); only the Gazebo render path sets the
	     measured value (robot_runtime.launch_support.render_gazebo_description)
	     — on Gazebo the shipped 10 (and 2.75) eject the grasped cube while
	     1.0 captures it (spike 1.1r diagnostics). First <xacro:arg>
	     declaration wins. -->
	<xacro:arg name="gripper_effort" default="10" />

	<!-- jaw_collision geoms (task 2.0b): one macro emitting EITHER the raw
	     finger STL collision (default) or the 8 CoACD hull pieces with the
	     MJCF template's gripper_col poses. Params: hulls_xyz/rpy and
	     mesh_xyz/rpy (the two poses), hull_mesh/mesh_mesh (the mesh base
	     names without .stl). -->
	<xacro:macro name="jaw_collision_geoms" params="hulls_xyz hulls_rpy hull_mesh mesh_xyz mesh_rpy mesh_mesh">
		<xacro:if value="${jaw_collision_hulls}">
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_0.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_1.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_2.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_3.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_4.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_5.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_6.stl" /></geometry></collision>
			<collision><origin xyz="${hulls_xyz}" rpy="${hulls_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${hull_mesh}_7.stl" /></geometry></collision>
		</xacro:if>
		<xacro:unless value="${jaw_collision_hulls}">
			<collision><origin xyz="${mesh_xyz}" rpy="${mesh_rpy}" /><geometry><mesh filename="package://so101_description/meshes/lerobot/so101/${mesh_mesh}.stl" /></geometry></collision>
		</xacro:unless>
	</xacro:macro>

	<!-- Links -->
	<link name="$(arg root_link)" />

	<joint name="base_joint" type="fixed">
		<parent link="$(arg root_link)" />
		<child link="base" />
		<origin xyz="0 0 0" rpy="0 0 0" />
	</joint>

	<!-- Materials -->
	<material name="3d_printed">
		<color rgba="1.0 0.82 0.12 1.0" />
	</material>
	<material name="sts3215">
		<color rgba="0.1 0.1 0.1 1.0" />
	</material>

	<!-- Link base -->
	<link name="base">
		<inertial>
			<origin xyz="0.020739 0.00204287 0.065966" rpy="0 0 0" />
			<mass value="0.147" />
			<inertia ixx="0.000136117" ixy="4.59787e-07" ixz="9.75275e-08" iyy="0.000114686"
