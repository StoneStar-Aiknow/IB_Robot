<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_sim" default="true"/>
    <xacro:arg name="port" default="/dev/ttyACM0"/>
    <xacro:arg name="calib_file" default=""/>
    <!-- Legacy explicit startup motion only. Semantic HOME belongs to the
         runtime model and must never be passed as reset_positions. -->
    <xacro:arg name="reset_positions" default=""/>
    <!-- Escalation bound (issue #138): how long a motor protection may stay
         active before the component reports ERROR (default 1 s). -->
    <xacro:arg name="protection_timeout" default=""/>
    <!-- simulated: run the SO101 hardware plugin on the SDK simulated transport
         (no serial port, no physics) so the production controller stack runs
         headless for runtime conformance. Independent of use_sim (Gazebo/MuJoCo). -->
    <xacro:arg name="simulated" default="false"/>
    <!-- sim_plugin: hardware plugin for simulation. Default = Gazebo.
         MuJoCo: description.py passes "mujoco_ros2_control/MujocoSystemInterface" when platform=mujoco. -->
    <xacro:arg name="sim_plugin" default="gz_ros2_control/GazeboSimSystem"/>
    <!-- sim_effort_state: expose the effort state interface so the runtime's
         simulated joint-current publisher can derive joint.current from the
         simulated effort (runtime-simulation-transport D6b). Physics
         transports only (Gazebo, MuJoCo); the hardware/SDK plugins do not
         export effort. -->
    <xacro:arg name="sim_effort_state" default="false"/>
    <xacro:arg name="mujoco_model" default=""/>
    <!-- mujoco_headless: the mujoco_ros2_control <hardware> "headless"
         parameter (no Simulate UI window). Camera rendering tries GLFW first
         and falls back to EGL when no display is available, so headless
         camera streaming needs no xvfb-run wrapper (mujoco_ros2_control
         0.1.2). Cameras themselves are configured through the simulator's
         CameraPlugin parameters, never through this file. -->
    <xacro:arg name="mujoco_headless" default="false"/>

    <ros2_control name="RobotSystem" type="system">
        <xacro:if value="$(arg use_sim)">
            <hardware>
                <plugin>$(arg sim_plugin)</plugin>
                <xacro:if value="${'$(arg mujoco_model)' != ''}">
                    <param name="mujoco_model">$(arg mujoco_model)</param>
                    <!-- Turn the deprecated URDF <sensor> camera
                         auto-registration off: cameras are configured through
                         the mujoco_plugins CameraPlugin parameters
                         (mujoco_ros2_control >= 0.1.0), and a model camera
                         that is somehow not configured must not be silently
                         auto-registered by the legacy path. -->
                    <param name="auto_register_cameras">false</param>
                </xacro:if>
                <xacro:if value="$(arg mujoco_headless)">
                    <param name="headless">true</param>
                </xacro:if>
            </hardware>
        </xacro:if>

        <xacro:unless value="$(arg use_sim)">
            <hardware>
                <plugin>so101_hardware/SO101SystemHardware</plugin>
                <param name="port">$(arg port)</param>
                <param name="calib_file">$(arg calib_file)</param>
                <param name="reset_positions">$(arg reset_positions)</param>
                <param name="protection_timeout">$(arg protection_timeout)</param>
                <param name="simulated">$(arg simulated)</param>
            </hardware>
        </xacro:unless>

        <joint name="1">
            <command_interface name="position">
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">1</param>
        </joint>

        <joint name="2">
            <command_interface name="position">
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">2</param>
        </joint>

        <joint name="3">
            <command_interface name="position">
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">3</param>
        </joint>

        <joint name="4">
            <command_interface name="position">
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">4</param>
        </joint>
        <joint name="5">
            <command_interface name="position">
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">5</param>
        </joint>

        <joint name="6">
            <!-- Follower model conversion maps closed to calibrated min and
                 open to calibrated max. This identifies the gripper and its
                 opening direction; leader drive_mode is a separate mapping. -->
            <param name="gripper_opening_direction">1</param>
            <command_interface name="position">
                <!-- Mechanical envelope in centered coordinates; the 0..1 URDF
                     joint limit element stays the simulation's model convention. -->
                <param name="min">-3.1416</param>
                <param name="max">3.1416</param>
                <param name="initial_value">0.0</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
            <xacro:if value="$(arg sim_effort_state)">
                <state_interface name="effort" />
            </xacro:if>
            <param name="id">6</param>
        </joint>
    </ros2_control>

</robot>
