<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice_tts_service</name>
  <version>0.1.0</version>
  <description>Manifest-backed typed ZipVoice TTS service for IB-Robot</description>
  <maintainer email="liuweihong8@huawei.com">liuweihong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ibrobot_msgs</depend>
  <depend>inference_manifest</depend>
  <depend>audio_common_msgs</depend>
  <exec_depend>inference_service</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Launch-builder registration (openspec change
       ``migrate-business-launch-builders``):
       launch_builders/voice_tts.py contributes the voice_tts entry to
       robot_config's launch registry through the ibrobot.launch_builders
       entry point group, importing robot_config at registration time; the
       pre-migration test_depend (test_robot_config_defaults_contract.py
       asserting the typed VoiceTTSConfig defaults track VOICE_TTS_DEFAULTS)
       merges into this depend. The dependency is one way: robot_config does
       not depend on this package. -->
  <depend>robot_config</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
