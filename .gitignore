# Offline X2 geometry/targets are deployment assets, not source model files.
/commissioning/fixed_poses*.json
# Except the approved library of aimdk_x2_voice_mirror_grasp, shared so a
# pulled tree reuses it while its motion fingerprint matches (no MuJoCo).
!/commissioning/fixed_poses.json

# Vendor SDK reference trees (never vendored: see
# src/robots/aimdk/aimdk_robot/README.md). AimDK is ~490 MB and its message
# package currently carries no license declaration. Root-anchored: this must
# not match the in-repo runtime package src/robots/aimdk/.
/aimdk/

# Unitree upstream checkouts used for analysis (BSD-3-Clause). Unlike AimDK the
# message packages and the G1 URDF ARE vendorable and will land under
# src/robots/unitree/; this tree is only the upstream working copy.
# Root-anchored so it cannot match the in-repo runtime package.
/unitree/

