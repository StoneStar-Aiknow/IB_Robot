+
+
+class CustomWeighter(SampleWeighter):
+    """Load per-frame weights from the dataset's ``training_weight`` column.
+
+    Ports the v0.5.1 ``custom_weights`` feature onto v0.6.0's native
+    SampleWeighter framework. The ``frame_detector`` tool writes a
+    ``training_weight`` column per frame; this weighter looks it up by the
+    batch's ``index`` key (global frame indices) and returns per-sample
+    weights for loss reweighting.
+    """
+
+    def __init__(self, device: torch.device, dataset_root: str | None = None, dataset_repo_id: str | None = None):
+        self.device = device
+        self.weights = None
+        self._load_weights(dataset_root, dataset_repo_id)
+
+    def _load_weights(self, dataset_root, dataset_repo_id):
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+
+        ds = LeRobotDataset(repo_id=dataset_repo_id, root=dataset_root)
+        if "training_weight" not in ds.hf_dataset.features:
+            raise ValueError(
+                "CustomWeighter requires a 'training_weight' column in the dataset "
+                f"(repo_id={dataset_repo_id}, root={dataset_root}). Run frame_detector first."
+            )
+        col = ds.hf_dataset["training_weight"]
+        self.weights = torch.tensor([float(x) for x in col], dtype=torch.float32, device=self.device)
+        if is_main_process := (int(__import__("os").environ.get("RANK", "0")) == 0):
+            logging.info(f"CustomWeighter loaded {len(self.weights)} training_weight values "
+                         f"(min={self.weights.min().item():.4f}, max={self.weights.max().item():.4f})")
+
+    def compute_batch_weights(self, batch: dict) -> tuple[torch.Tensor, dict]:
+        if "index" not in batch:
+            raise ValueError("CustomWeighter needs batch['index'] (global frame indices); "
+                             "ensure the dataset/collate populates it.")
+        indices = batch["index"].to(self.device).long()
+        weights = self.weights[indices]
+        return weights, {"mean_weight": weights.mean().item(), "type": "custom"}
+
+    def get_stats(self) -> dict:
+        return {"type": "custom"}
