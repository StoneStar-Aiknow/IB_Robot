+    @property
+    def device(self):
+        """The device this model computes on.
+
+        Not simply the first parameter's: a deployment may keep part of the
+        model on the host on purpose -- an encoder whose irregular work is
+        faster there -- and the first parameter in registration order can
+        then be a CPU one while the rest of the network is on an
+        accelerator. The per-request tensors have to join the accelerator,
+        so that is what this reports, and two accelerators at once are
+        rejected rather than guessed between.
+        """
+        cached = self.__dict__.get('_compute_device')
+        if cached is not None:
+            return cached
+        devices = {parameter.device for parameter in self.model.parameters()}
+        accelerators = sorted({d for d in devices if d.type != 'cpu'}, key=str)
+        if len(accelerators) > 1:
+            raise RuntimeError(
+                f"the model spans several accelerators {accelerators}; "
+                "GraspGenX cannot choose where a request's tensors belong"
+            )
+        device = accelerators[0] if accelerators else torch.device('cpu')
+        self.__dict__['_compute_device'] = device
+        return device
+
