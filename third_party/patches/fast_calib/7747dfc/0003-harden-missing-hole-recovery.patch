diff --git a/test/test_target_geometry.cpp b/test/test_target_geometry.cpp
new file mode 100644
index 0000000..c02f314
--- /dev/null
+++ b/test/test_target_geometry.cpp
@@ -0,0 +1,66 @@
+#include "target_geometry.hpp"
+
+#include <array>
+#include <cmath>
+#include <stdexcept>
+
+using fast_calib::Point3;
+
+namespace
+{
+
+void assert_close(double actual, double expected)
+{
+    if (std::abs(actual - expected) >= 1e-9)
+    {
+        throw std::runtime_error("values are not close");
+    }
+}
+
+void require(bool condition, const char *message)
+{
+    if (!condition)
+    {
+        throw std::runtime_error(message);
+    }
+}
+
+}  // namespace
+
+int main()
+{
+    constexpr double width = 0.50;
+    constexpr double height = 0.40;
+    constexpr double tolerance = 0.06;
+
+    const std::array<Point3, 3> valid_l = {
+        Point3{0.0, 0.0, 0.0}, Point3{width, 0.0, 0.0}, Point3{0.0, height, 0.0}};
+    std::array<Point3, 4> recovered{};
+    require(fast_calib::recover_rectangle(valid_l, width, height, tolerance, recovered),
+            "valid L pattern was rejected");
+    assert_close(recovered[3].x, width);
+    assert_close(recovered[3].y, height);
+
+    // Both arms have plausible lengths, but their 51-degree angle is not a board corner.
+    const std::array<Point3, 3> oblique_l = {
+        Point3{0.0, 0.0, 0.0},
+        Point3{width, 0.0, 0.0},
+        Point3{height * 0.629320391, height * 0.777145961, 0.0}};
+    require(!fast_calib::recover_rectangle(oblique_l, width, height, tolerance, recovered),
+            "oblique L pattern was accepted");
+
+    // Regression for a background-derived false observation seen in scene-02.
+    const std::array<Point3, 4> scene_02_false_pattern = {
+        Point3{0.0, 0.0, 0.0},
+        Point3{0.447, 0.0, 0.0},
+        Point3{-0.123793, 0.518245, 0.0},
+        Point3{0.323207, 0.518245, 0.0}};
+    require(!fast_calib::has_rectangle_distance_spectrum(scene_02_false_pattern, width, height, tolerance),
+            "scene-02 false distance spectrum was accepted");
+
+    const std::array<Point3, 4> rectangle = {
+        Point3{0.0, 0.0, 0.0}, Point3{width, 0.0, 0.0},
+        Point3{0.0, height, 0.0}, Point3{width, height, 0.0}};
+    require(fast_calib::has_rectangle_distance_spectrum(rectangle, width, height, tolerance),
+            "valid rectangle distance spectrum was rejected");
+}
