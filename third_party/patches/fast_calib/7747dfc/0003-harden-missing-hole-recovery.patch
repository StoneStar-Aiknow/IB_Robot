+#ifndef TARGET_GEOMETRY_HPP
+#define TARGET_GEOMETRY_HPP
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace fast_calib
+{
+
+struct Point3
+{
+    double x;
+    double y;
+    double z;
+};
+
+inline double distance(const Point3 &a, const Point3 &b)
+{
+    const double dx = a.x - b.x;
+    const double dy = a.y - b.y;
+    const double dz = a.z - b.z;
+    return std::sqrt(dx * dx + dy * dy + dz * dz);
+}
+
+inline bool has_rectangle_distance_spectrum(
+    const std::array<Point3, 4> &points, double width, double height, double tolerance)
+{
+    std::array<double, 6> actual{};
+    size_t index = 0;
+    for (size_t i = 0; i < points.size(); ++i)
+    {
+        for (size_t j = i + 1; j < points.size(); ++j)
+        {
+            actual[index++] = distance(points[i], points[j]);
+        }
+    }
+    std::sort(actual.begin(), actual.end());
+
+    const double diagonal = std::hypot(width, height);
+    std::array<double, 6> expected = {height, height, width, width, diagonal, diagonal};
+    std::sort(expected.begin(), expected.end());
+    for (size_t i = 0; i < actual.size(); ++i)
+    {
+        if (std::abs(actual[i] - expected[i]) >= tolerance)
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline bool recover_rectangle(
+    const std::array<Point3, 3> &measured, double width, double height, double tolerance,
+    std::array<Point3, 4> &recovered)
+{
+    size_t matches = 0;
+    for (size_t i = 0; i < measured.size(); ++i)
+    {
+        const size_t j = (i + 1) % measured.size();
+        const size_t k = (i + 2) % measured.size();
+        const Point3 &corner = measured[i];
+        const Point3 &first = measured[j];
+        const Point3 &second = measured[k];
+        const double first_length = distance(corner, first);
+        const double second_length = distance(corner, second);
+        const bool lengths_match =
+            (std::abs(first_length - width) < tolerance && std::abs(second_length - height) < tolerance) ||
+            (std::abs(first_length - height) < tolerance && std::abs(second_length - width) < tolerance);
+        if (!lengths_match)
+        {
+            continue;
+        }
+
+        const double dot =
+            (first.x - corner.x) * (second.x - corner.x) +
+            (first.y - corner.y) * (second.y - corner.y) +
+            (first.z - corner.z) * (second.z - corner.z);
+        const double max_abs_cosine = tolerance / std::min(width, height);
+        if (std::abs(dot) > max_abs_cosine * first_length * second_length)
+        {
+            continue;
+        }
+
+        const Point3 inferred = {
+            first.x + second.x - corner.x,
+            first.y + second.y - corner.y,
+            first.z + second.z - corner.z,
+        };
+        const std::array<Point3, 4> candidate = {corner, first, second, inferred};
+        if (!has_rectangle_distance_spectrum(candidate, width, height, tolerance))
+        {
+            continue;
+        }
+        recovered = candidate;
+        ++matches;
+    }
+    return matches == 1;
+}
+
+}  // namespace fast_calib
+
+#endif
