     double z;
 };
 
+struct ScoredPoint
+{
+    Point3 point;
+    double score;
+};
+
 inline double distance(const Point3 &a, const Point3 &b)
 {
     const double dx = a.x - b.x;
@@ -98,6 +106,54 @@ inline bool recover_rectangle(
     return matches == 1;
 }
 
+inline bool select_unique_rectangle(
+    const std::vector<ScoredPoint> &candidates, double width, double height,
+    double distance_tolerance, double minimum_score_margin, std::array<Point3, 4> &selected)
+{
+    double best_score = -std::numeric_limits<double>::infinity();
+    double second_score = -std::numeric_limits<double>::infinity();
+    std::array<Point3, 4> best{};
+    for (size_t i = 0; i < candidates.size(); ++i)
+    {
+        for (size_t j = i + 1; j < candidates.size(); ++j)
+        {
+            for (size_t k = j + 1; k < candidates.size(); ++k)
+            {
+                for (size_t l = k + 1; l < candidates.size(); ++l)
+                {
+                    const std::array<Point3, 4> points = {
+                        candidates[i].point, candidates[j].point,
+                        candidates[k].point, candidates[l].point};
+                    if (!has_rectangle_distance_spectrum(points, width, height, distance_tolerance))
+                    {
+                        continue;
+                    }
+                    const double score = std::min({
+                        candidates[i].score, candidates[j].score,
+                        candidates[k].score, candidates[l].score});
+                    if (score > best_score)
+                    {
+                        second_score = best_score;
+                        best_score = score;
+                        best = points;
+                    }
+                    else if (score > second_score)
+                    {
+                        second_score = score;
+                    }
+                }
+            }
+        }
+    }
+    if (!std::isfinite(best_score) ||
+        (std::isfinite(second_score) && best_score - second_score < minimum_score_margin))
+    {
+        return false;
+    }
+    selected = best;
+    return true;
+}
+
 }  // namespace fast_calib
 
 #endif
