 #include <pcl_conversions/pcl_conversions.h>
 #include <rclcpp/rclcpp.hpp>
+#include <fstream>
 
 #include "qr_detect.hpp"
 #include "lidar_detect.hpp"
 #include "data_preprocess.hpp"
 
+static bool saveObservation(const Params &params,
+                            const pcl::PointCloud<pcl::PointXYZ>::Ptr &camera_centers,
+                            const pcl::PointCloud<pcl::PointXYZ>::Ptr &lidar_centers)
+{
+  if (params.scene_id.empty())
+  {
+    return false;
+  }
+  std::string output_dir = params.output_path;
+  if (output_dir.back() != '/') output_dir += '/';
+  std::ofstream stream(output_dir + "observation.yaml");
+  if (!stream.is_open()) return false;
+  const auto write_centers = [&stream](const char *name, const pcl::PointCloud<pcl::PointXYZ>::Ptr &centers) {
+    stream << name << ":\n";
+    for (const auto &point : centers->points)
+      stream << "  - [" << point.x << ", " << point.y << ", " << point.z << "]\n";
+  };
+  stream << "schema_version: \"1.0\"\n"
+         << "scene_id: " << params.scene_id << "\n"
+         << "source_frame: body\n"
+         << "target_frame: camera_front_optical_frame\n";
+  write_centers("camera_centers", camera_centers);
+  write_centers("lidar_centers", lidar_centers);
+  return stream.good();
+}
+
