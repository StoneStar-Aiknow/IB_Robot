+    def get_last_motion_planned(self) -> Optional[bool]:
+        """Whether the last move_action goal produced a planned trajectory.
+
+        True or False once that goal reached a terminal state (False = the
+        action aborted before any plan existed, so no trajectory was ever
+        handed to a controller); None while no result has arrived for the
+        current goal (also when the goal was rejected outright).
+        """
+        return self.__last_motion_planned
+
+    def get_last_goal_sequence(self) -> int:
+        """Monotonic count of goals actually sent to an action server.
+
+        Incremented only after the send's readiness check passes, next to
+        the evidence reset, so comparing the value across a send call is
+        POSITIVE evidence of whether a goal was dispatched: the send paths
+        can return without dispatching (the action server unavailable, or
+        ``ignore_new_calls_while_executing`` skipped the call) and the
+        state/evidence alone cannot distinguish that from a goal that
+        terminalized before the first state query.
+        """
+        return self.__goal_sequence
+
+    @staticmethod
+    def result_planned_a_trajectory(result) -> bool:
+        """Whether a MoveGroup action result carries a non-empty plan."""
+        trajectory = result.planned_trajectory
+        return bool(
+            getattr(getattr(trajectory, "joint_trajectory", None), "points", None)
+            or getattr(getattr(trajectory, "multi_dof_joint_trajectory", None), "points", None)
+        )
